<?xml version="1.0" encoding="utf-8"?>
<!--
  Moss: the field the mark sits on. Deliberately a mid-tone rather than a pastel tint,
  because this is the one value in the palette that has to hold its shape against a pale
  wallpaper as well as a dark one.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#8DB48F" />
                <item android:offset="1" android:color="#57815F" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
