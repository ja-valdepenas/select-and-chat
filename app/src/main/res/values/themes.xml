<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Platform DayNight, not AppCompat: with minSdk 33 there is nothing left to backport,
      and this only has to dress the launch window until setContent runs and the Compose
      colour scheme takes over.
    -->
    <style name="Theme.SelectAndChat" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
      ProcessTextActivity renders nothing in the common case: it resolves the number,
      fires the intent and finishes. A translucent window with no animation keeps that
      path visually silent. The bottom sheet supplies its own scrim when it is needed,
      so window dimming stays off.
    -->
    <style name="Theme.SelectAndChat.Translucent" parent="Theme.SelectAndChat">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>
